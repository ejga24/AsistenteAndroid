<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/nexo_page_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intelligence"
            android:textColor="@color/nexo_text"
            style="@style/Nexo.Text.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura el motor que usa NEXO para entender, planificar y encadenar acciones."
            style="@style/Nexo.Text.BodyMuted"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nexo_surface"
            app:cardCornerRadius="@dimen/nexo_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexo_outline"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CREDENCIALES"
                    style="@style/Nexo.Text.SectionAccent"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="La clave se cifra con Android Keystore y nunca se incluye en GitHub."
                    style="@style/Nexo.Text.BodyMuted"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Las solicitudes complejas y las capturas de Vision se envían al motor configurado solo cuando usas esas capacidades. NEXO solicita no almacenar esas respuestas."
                    style="@style/Nexo.Text.BodyMuted"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Nexo.Input"
                    android:id="@+id/apiKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="OpenAI API key"
                    android:textColor="@color/nexo_text"
                    android:textColorHint="@color/nexo_text_muted"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODELO"
                    style="@style/Nexo.Text.Section" />

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Nexo.Input"
                    android:id="@+id/modelInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Modelo"
                    android:textColor="@color/nexo_text"
                    android:textColorHint="@color/nexo_text_muted"
                    android:singleLine="true"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button"
            android:id="@+id/saveAiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar inteligencia"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/removeAiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desconectar credencial" />
    </LinearLayout>
</ScrollView>
