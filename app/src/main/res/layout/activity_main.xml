<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXO"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGENT OS · v3.0 alpha"
            android:textSize="12sp"
            android:layout_marginBottom="22dp" />
        <View
            android:id="@+id/orbView"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginBottom="22dp" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inicializando NEXO…"
            android:textSize="19sp"
            android:gravity="center"
            android:layout_marginBottom="10dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Di “NEXO” · escucha manos libres"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />
        <Button
            android:id="@+id/micPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dar permiso de micrófono"
            android:layout_marginBottom="10dp" />
        <Button
            android:id="@+id/aiSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de aplicaciones"
            android:layout_marginBottom="10dp" />
        <Button
            android:id="@+id/intelligenceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inteligencia de NEXO"
            android:layout_marginBottom="10dp" />
        <Button
            android:id="@+id/carModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar modo carro"
            android:layout_marginBottom="10dp" />
        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actividad de NEXO" />
    </LinearLayout>
</ScrollView>