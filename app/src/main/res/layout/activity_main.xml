<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/nexo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/nexo_page_padding"
        android:paddingEnd="@dimen/nexo_page_padding"
        android:paddingTop="@dimen/nexo_page_padding_top"
        android:paddingBottom="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXO"
                    style="@style/Nexo.Text.Hero" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGENT OS"
                    android:textColor="@color/nexo_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/systemStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●  Inicializando"
                android:textColor="@color/nexo_warning"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:background="@color/nexo_surface_alt" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nexo_surface"
            app:cardCornerRadius="@dimen/nexo_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexo_outline"
            app:strokeWidth="1dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="26dp">

                <View
                    android:id="@+id/orbView"
                    android:layout_width="@dimen/nexo_orb_size"
                            android:layout_height="@dimen/nexo_orb_size"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inicializando NEXO…"
                    android:textColor="@color/nexo_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Di “NEXO” · manos libres"
                    style="@style/Nexo.Text.BodyMuted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nowRunningCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/nexo_accent_soft"
            app:cardCornerRadius="@dimen/nexo_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexo_accent"
            app:strokeWidth="1dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOW RUNNING"
                            style="@style/Nexo.Text.SectionAccent" />

                        <TextView
                            android:id="@+id/planTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ejecutando plan"
                            android:textColor="@color/nexo_text"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_marginTop="5dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/planProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 1"
                        android:textColor="@color/nexo_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/planStepsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preparando acciones…"
                    android:textColor="@color/nexo_text"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Nexo.Button.Secondary"
                    android:id="@+id/cancelPlanButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detener plan" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="18dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="@color/nexo_surface_alt"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/nexo_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SISTEMA"
                        style="@style/Nexo.Text.Section" />

                    <TextView
                        android:id="@+id/healthText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Verificando permisos…"
                        android:textColor="@color/nexo_text"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="@color/nexo_surface_alt"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/nexo_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAPACIDADES"
                        style="@style/Nexo.Text.Section" />

                    <TextView
                        android:id="@+id/skillsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cargando skills…"
                        android:textColor="@color/nexo_text"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROLES"
            style="@style/Nexo.Text.Section"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/micPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dar permiso de micrófono"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/aiSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de aplicaciones"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/intelligenceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inteligencia de NEXO"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/carModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar modo carro"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/voiceToggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pausar escucha"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actividad de NEXO"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/diagnosticsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System Health"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/securityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security &amp; Privacy"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/visionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vision"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/setupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setup Center"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/modesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modes"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/skillsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skills" />
    </LinearLayout>
</ScrollView>
