<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mía"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciando escucha automática…"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Di “Mía” para activarla · manos libres activo"
        android:textSize="15sp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/micPermissionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dar permiso de micrófono"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/aiSettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activar control de apps" />

</LinearLayout>
