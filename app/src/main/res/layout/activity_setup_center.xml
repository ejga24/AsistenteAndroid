<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            style="@style/Nexo.Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setup Center" />

        <TextView
            style="@style/Nexo.Text.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prepara NEXO para operar con todas sus capacidades."
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nexo_surface"
            app:cardCornerRadius="@dimen/nexo_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexo_outline"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Nexo.Text.SectionAccent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREPARACIÓN" />

                <TextView
                    android:id="@+id/setupProgressText"
                    style="@style/Nexo.Text.H1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0% listo"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/setupChecklistText"
                    style="@style/Nexo.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/setupMicButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permisos de NEXO"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/setupAccessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de aplicaciones"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/setupIntelligenceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar inteligencia"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/setupVisionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparar Vision" />
    </LinearLayout>
</ScrollView>
