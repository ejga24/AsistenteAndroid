<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            style="@style/Nexo.Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modes" />

        <TextView
            style="@style/Nexo.Text.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfiles de comportamiento para adaptar NEXO al contexto."
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nexo_surface"
            app:cardCornerRadius="@dimen/nexo_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexo_outline"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Nexo.Text.SectionAccent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO" />

                <TextView
                    android:id="@+id/currentModeText"
                    style="@style/Nexo.Text.H1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo actual · Normal"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Nexo.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISPONIBLES"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button.Secondary"
            android:id="@+id/modeNormalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Normal · comportamiento general"
            android:layout_marginBottom="9dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Nexo.Button"
            android:id="@+id/modeCarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carro · pantalla activa y manos libres"
            android:layout_marginBottom="18dp" />

        <TextView
            style="@style/Nexo.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN PREPARACIÓN"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nexo_surface_alt"
            app:cardCornerRadius="@dimen/nexo_card_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexo_outline"
            app:strokeWidth="1dp">

            <TextView
                style="@style/Nexo.Text.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Casa · Trabajo · Kiosco&#10;&#10;Ya forman parte de la arquitectura, pero permanecerán desactivados hasta que cada perfil tenga reglas completas y pase QA." />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
