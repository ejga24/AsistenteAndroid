<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexo_bg"
    android:padding="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activity"
        android:textColor="@color/nexo_text"
        android:textStyle="bold"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registro de decisiones y acciones de NEXO"
        android:textColor="@color/nexo_text_muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/nexo_surface"
        app:cardCornerRadius="@dimen/nexo_card_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/nexo_outline"
        app:strokeWidth="1dp"
        android:layout_marginBottom="14dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/historyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/nexo_text"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:padding="20dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/clearHistoryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Borrar actividad" />
</LinearLayout>
