<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/nexo_surface"
    android:padding="22dp">

    <TextView
        style="@style/Nexo.Text.SectionAccent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AUTORIZACIÓN" />

    <TextView
        style="@style/Nexo.Text.H1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirmar acción"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/confirmActionText"
        style="@style/Nexo.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/confirmReasonText"
        style="@style/Nexo.Text.BodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="18dp" />

    <TextView
        style="@style/Nexo.Text.BodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NEXO solo continuará si autorizas esta acción."
        android:textSize="12sp"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmCancelButton"
            style="@style/Nexo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmApproveButton"
            style="@style/Nexo.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Autorizar"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
