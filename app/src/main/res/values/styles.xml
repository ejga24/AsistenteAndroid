<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Nexo.Text.H1" parent="">
        <item name="android:textColor">@color/nexo_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Nexo.Text.Hero" parent="">
        <item name="android:textColor">@color/nexo_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.13</item>
    </style>

    <style name="Nexo.Text.Body" parent="">
        <item name="android:textColor">@color/nexo_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Nexo.Text.BodyMuted" parent="">
        <item name="android:textColor">@color/nexo_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Nexo.Text.Section" parent="">
        <item name="android:textColor">@color/nexo_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="Nexo.Text.SectionAccent" parent="Nexo.Text.Section">
        <item name="android:textColor">@color/nexo_accent</item>
    </style>

    <style name="Nexo.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/nexo_touch_min</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Nexo.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Nexo.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/nexo_surface</item>
        <item name="cardCornerRadius">@dimen/nexo_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/nexo_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Nexo.Card.Accent" parent="Nexo.Card">
        <item name="cardBackgroundColor">@color/nexo_accent_soft</item>
        <item name="strokeColor">@color/nexo_accent</item>
    </style>

    <style name="Nexo.Input" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/nexo_text</item>
        <item name="android:textColorHint">@color/nexo_text_muted</item>
    </style>

</resources>
